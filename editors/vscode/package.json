{
    "name": "dapcode-lang",
    "displayName": "DapCode Language Support",
    "description": "Syntax highlighting, LSP with Code Actions & Quick Fixes, interactive Debugger (DAP) with breakpoints & variable inspection, Go to Definition, outline symbols, snippets, doc generator, test runner, and interactive REPL for DapCode (.dap)",
    "version": "0.9.2",
    "publisher": "dapcode-core",
    "icon": "icons/dapcode.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/codedaffa/dapcode-lang"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters",
        "Testing"
    ],
    "keywords": [
        "dapcode",
        "dapcodec",
        "dql",
        "database",
        "query-language",
        "compiler",
        "indonesia",
        "rust",
        "language-server",
        "testing",
        "repl",
        "documentation"
    ],
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:dapcode",
        "onLanguage:dql",
        "onCommand:dapcode.openPlayground",
        "onCommand:dapcode.run",
        "onCommand:dapcode.test",
        "onCommand:dapcode.repl",
        "onCommand:dapcode.doc",
        "onCommand:dapcode.check",
        "onCommand:dapcode.build",
        "onCommand:dapcode.buildMobile",
        "onCommand:dapcode.previewMobileGpu",
        "onCommand:dapcode.debug",
        "onCommand:dapcode.restartLsp",
        "onCommand:dapcode.dqlCompile",
        "onCommand:dapcode.dqlRepl",
        "onCommand:dapcode.dqlLive"
    ],
    "contributes": {
        "languages": [
            {
                "id": "dapcode",
                "aliases": [
                    "DapCode",
                    "dapcode",
                    "dap"
                ],
                "extensions": [
                    ".dap"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/dapcode-light.svg",
                    "dark": "./icons/dapcode.svg"
                }
            },
            {
                "id": "dql",
                "aliases": [
                    "DapCode Query Language",
                    "DQL",
                    "dql"
                ],
                "extensions": [
                    ".dql"
                ],
                "configuration": "./dql-language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "dapcode",
                "scopeName": "source.dap",
                "path": "./syntaxes/dapcode.tmLanguage.json"
            },
            {
                "language": "dql",
                "scopeName": "source.dql",
                "path": "./syntaxes/dql.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "dapcode",
                "path": "./snippets/dapcode.json"
            },
            {
                "language": "dql",
                "path": "./snippets/dql.json"
            }
        ],
        "breakpoints": [
            {
                "language": "dapcode"
            }
        ],
        "debuggers": [
            {
                "type": "dapcode",
                "label": "DapCode Debugger",
                "languages": [
                    "dapcode"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Jalur berkas sumber DapCode (.dap) yang akan di-debug",
                                "default": "${file}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Berhenti otomatis pada baris pertama fungsi utama",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "dapcode",
                        "request": "launch",
                        "name": "DapCode: Debug Berkas Aktif",
                        "program": "${file}",
                        "stopOnEntry": false
                    }
                ]
            }
        ],
        "commands": [
            {
                "command": "dapcode.run",
                "title": "DapCode: Jalankan Berkas Aktif (Run)",
                "category": "DapCode",
                "icon": "$(play)"
            },
            {
                "command": "dapcode.test",
                "title": "DapCode: Jalankan Pengujian Unit (Test)",
                "category": "DapCode",
                "icon": "$(beaker)"
            },
            {
                "command": "dapcode.repl",
                "title": "DapCode: Buka Interactive REPL",
                "category": "DapCode",
                "icon": "$(terminal)"
            },
            {
                "command": "dapcode.doc",
                "title": "DapCode: Hasilkan Dokumentasi Proyek (Doc)",
                "category": "DapCode",
                "icon": "$(book)"
            },
            {
                "command": "dapcode.check",
                "title": "DapCode: Periksa Tipe & Kepemilikan (Check)",
                "category": "DapCode",
                "icon": "$(shield)"
            },
            {
                "command": "dapcode.build",
                "title": "DapCode: Kompilasi ke Biner Mandiri (Build)",
                "category": "DapCode",
                "icon": "$(package)"
            },
            {
                "command": "dapcode.restartLsp",
                "title": "DapCode: Mulai Ulang Language Server (LSP)",
                "category": "DapCode",
                "icon": "$(refresh)"
            },
            {
                "command": "dapcode.debug",
                "title": "DapCode: Debug Berkas Aktif (Debug)",
                "category": "DapCode",
                "icon": "$(debug-alt)"
            },
            {
                "command": "dapcode.openPlayground",
                "title": "DapCode: Buka Live Canvas 2D & Playground Berkas Aktif",
                "category": "DapCode",
                "icon": "$(play-circle)"
            },
            {
                "command": "dapcode.buildMobile",
                "title": "DapCode: Bangun Aplikasi Mobile Native (Android, iOS & Desktop)",
                "category": "DapCode",
                "icon": "$(package)"
            },
            {
                "command": "dapcode.previewMobileGpu",
                "title": "DapCode: Pratinjau Mobile GPU (Direct 60 FPS Hot-Reload)",
                "category": "DapCode",
                "icon": "$(device-mobile)"
            },
            {
                "command": "dapcode.dqlCompile",
                "title": "DQL: Kompilasi ke SQL (Compile to SQL)",
                "category": "DQL",
                "icon": "$(database)"
            },
            {
                "command": "dapcode.dqlRepl",
                "title": "DQL: Buka Sesi Interaktif REPL",
                "category": "DQL",
                "icon": "$(terminal)"
            },
            {
                "command": "dapcode.dqlLive",
                "title": "DQL: Buka Sesi Live Database (Eksekusi Nyata)",
                "category": "DQL",
                "icon": "$(zap)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "dapcode.dqlCompile",
                    "when": "resourceLangId == dql",
                    "group": "navigation@1"
                },
                {
                    "command": "dapcode.dqlRepl",
                    "when": "resourceLangId == dql",
                    "group": "navigation@2"
                },
                {
                    "command": "dapcode.dqlLive",
                    "when": "resourceLangId == dql",
                    "group": "navigation@3"
                },
                {
                    "command": "dapcode.previewMobileGpu",
                    "when": "resourceLangId == dapcode",
                    "group": "navigation@0"
                },
                {
                    "command": "dapcode.run",
                    "when": "resourceLangId == dapcode",
                    "group": "navigation@1"
                },
                {
                    "command": "dapcode.test",
                    "when": "resourceLangId == dapcode",
                    "group": "navigation@2"
                },
                {
                    "command": "dapcode.repl",
                    "when": "resourceLangId == dapcode",
                    "group": "navigation@3"
                },
                {
                    "command": "dapcode.openPlayground",
                    "when": "resourceLangId == dapcode",
                    "group": "navigation@4"
                }
            ],
            "editor/context": [
                {
                    "command": "dapcode.dqlCompile",
                    "when": "resourceLangId == dql",
                    "group": "1_modification@1"
                },
                {
                    "command": "dapcode.dqlRepl",
                    "when": "resourceLangId == dql",
                    "group": "1_modification@2"
                },
                {
                    "command": "dapcode.dqlLive",
                    "when": "resourceLangId == dql",
                    "group": "1_modification@3"
                },
                {
                    "command": "dapcode.previewMobileGpu",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@0"
                },
                {
                    "command": "dapcode.run",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@1"
                },
                {
                    "command": "dapcode.test",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@2"
                },
                {
                    "command": "dapcode.repl",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@3"
                },
                {
                    "command": "dapcode.doc",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@4"
                },
                {
                    "command": "dapcode.check",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@5"
                },
                {
                    "command": "dapcode.build",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@6"
                },
                {
                    "command": "dapcode.openPlayground",
                    "when": "resourceLangId == dapcode",
                    "group": "1_modification@7"
                }
            ]
        },
        "keybindings": [
            {
                "command": "dapcode.previewMobileGpu",
                "key": "ctrl+f5",
                "mac": "cmd+f5",
                "when": "editorLangId == dapcode"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "DapCode",
            "properties": {
                "dapcode.compilerPath": {
                    "type": "string",
                    "default": "dapcodec",
                    "description": "Jalur executable kompilator dapcodec (default: 'dapcodec')."
                },
                "dapcode.dqlPath": {
                    "type": "string",
                    "default": "dql",
                    "description": "Jalur executable toolchain DQL (default: 'dql')."
                },
                "dapcode.enableLsp": {
                    "type": "boolean",
                    "default": true,
                    "description": "Aktifkan integrasi LSP otomatis untuk diagnostik, hover, dan auto-completion."
                }
            }
        }
    }
}
