{
    "Fungsi": {
        "prefix": "fungsi",
        "body": [
            "fungsi ${1:nama_fungsi}(${2:parameter}: ${3:Teks}) -> ${4:Unit} {",
            "\t$0",
            "}"
        ],
        "description": "Deklarasi fungsi DapCode"
    },
    "Fungsi Utama": {
        "prefix": "utama",
        "body": [
            "fungsi utama() {",
            "\t$0",
            "}"
        ],
        "description": "Titik masuk utama program DapCode (fungsi utama)"
    },
    "Struktur": {
        "prefix": "struktur",
        "body": [
            "struktur ${1:NamaStruktur} {",
            "\t${2:nama_bidang}: ${3:Teks},",
            "\t$0",
            "}"
        ],
        "description": "Deklarasi struktur data (struktur)"
    },
    "Sifat / Trait": {
        "prefix": "sifat",
        "body": [
            "sifat ${1:NamaSifat} {",
            "\tfungsi ${2:nama_metode}(ini) -> ${3:Teks}",
            "}"
        ],
        "description": "Deklarasi sifat / trait (sifat)"
    },
    "Terapkan Sifat": {
        "prefix": "terapkan",
        "body": [
            "terapkan ${1:NamaSifat} untuk ${2:NamaStruktur} {",
            "\tfungsi ${3:nama_metode}(ini) -> ${4:Teks} {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Implementasi sifat/trait untuk suatu struktur"
    },
    "Terapkan Metode": {
        "prefix": "metode",
        "body": [
            "terapkan ${1:NamaStruktur} {",
            "\tfungsi ${2:nama_metode}(ini) -> ${3:Unit} {",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Implementasi metode khusus untuk struktur"
    },
    "Percabangan Jika": {
        "prefix": "jika",
        "body": [
            "jika ${1:kondisi} {",
            "\t$2",
            "} selain_itu {",
            "\t$0",
            "}"
        ],
        "description": "Percabangan kondisi jika dan selain_itu"
    },
    "Perulangan Selama": {
        "prefix": "selama",
        "body": [
            "selama ${1:kondisi} {",
            "\t$0",
            "}"
        ],
        "description": "Perulangan kondisi selama (while loop)"
    },
    "Perulangan Untuk Koleksi": {
        "prefix": "untuk",
        "body": [
            "untuk ${1:item} di ${2:koleksi} {",
            "\t$0",
            "}"
        ],
        "description": "Perulangan untuk setiap item di koleksi (for-in loop)"
    },
    "Konkurensi Jalan Paralel": {
        "prefix": "jalan_paralel",
        "body": [
            "${1:tugas} := jalan_paralel {",
            "\t$0",
            "}",
            "${2:hasil} := tunggu(${1:tugas})"
        ],
        "description": "Blok coroutine asinkron jalan_paralel dan sinkronisasi tunggu"
    },
    "Penanganan Kesalahan Tangkap": {
        "prefix": "tangkap",
        "body": [
            "? tangkap ${1:err} {",
            "\t$0",
            "}"
        ],
        "description": "Blok inline penanganan kesalahan (? tangkap err)"
    },
    "Pernyataan Impor": {
        "prefix": "impor",
        "body": [
            "impor \"${1:modul.dap}\""
        ],
        "description": "Impor berkas modul DapCode"
    },
    "Cetak Konsol": {
        "prefix": "cetak",
        "body": [
            "cetak(\"${1:pesan}\")"
        ],
        "description": "Cetak pesan atau nilai ke konsol"
    },
    "Serialisasi JSON": {
        "prefix": "ke_json",
        "body": [
            "${1:teks_json} := ke_json(${2:data})"
        ],
        "description": "Serialisasi nilai atau struktur data ke string JSON"
    },
    "Penguraian Kunci JSON": {
        "prefix": "ambil_kunci_json",
        "body": [
            "${1:nilai} := ambil_kunci_json(${2:teks_json}, \"${3:kunci}\") ? tangkap err {",
            "\t$0",
            "}"
        ],
        "description": "Ekstrak kunci dari teks JSON dengan penanganan error"
    },
    "Comptime Block": {
        "prefix": "comptime",
        "body": [
            "${1:hasil} := comptime {",
            "\t$0",
            "}"
        ],
        "description": "Evaluasi blok ekspresi saat fase kompilasi"
    },
    "HTTP GET Request": {
        "prefix": "ambil_http",
        "body": [
            "${1:respons} := ambil_http(\"${2:https://api.example.com/data}\") ? tangkap ${3:err} {",
            "\tcetak(\"Gagal HTTP GET: {${3:err}}\")",
            "\t$0",
            "}"
        ],
        "description": "Melakukan HTTP GET request dengan penanganan kesalahan"
    },
    "HTTP POST JSON Request": {
        "prefix": "kirim_http_post",
        "body": [
            "${1:respons} := kirim_http_post(\"${2:https://api.example.com/data}\", ${3:data_json}) ? tangkap ${4:err} {",
            "\tcetak(\"Gagal HTTP POST: {${4:err}}\")",
            "\t$0",
            "}"
        ],
        "description": "Melakukan HTTP POST request dengan payload JSON"
    },
    "Blok Pengujian Uji": {
        "prefix": "uji",
        "body": [
            "uji \"${1:skenario pengujian}\" {",
            "\t${2:hasil} := ${3:fungsi_diuji()}",
            "\tpastikan_sama(${2:hasil}, ${4:nilai_diharapkan})",
            "\t$0",
            "}"
        ],
        "description": "Blok unit test bawaan DapCode"
    },
    "Asersi Pastikan": {
        "prefix": "pastikan",
        "body": [
            "pastikan(${1:kondisi})"
        ],
        "description": "Asersi kebenaran kondisi dalam blok pengujian"
    },
    "Asersi Pastikan Sama": {
        "prefix": "pastikan_sama",
        "body": [
            "pastikan_sama(${1:sebenarnya}, ${2:diharapkan})"
        ],
        "description": "Asersi kesamaan dua nilai dalam blok pengujian"
    },
    "Asersi Pastikan Tidak Sama": {
        "prefix": "pastikan_tidak_sama",
        "body": [
            "pastikan_tidak_sama(${1:a}, ${2:b})"
        ],
        "description": "Asersi ketidaksamaan dua nilai dalam pengujian"
    },
    "Dokumen Modul": {
        "prefix": "docm",
        "body": [
            "//! # ${1:Nama Modul}",
            "//!",
            "//! ${2:Deskripsi modul dan penjelasan penggunaannya.}"
        ],
        "description": "Komentar dokumentasi tingkat modul //!"
    },
    "Dokumen Fungsi / Simbol": {
        "prefix": "doc",
        "body": [
            "/// ${1:Deskripsi fungsi atau struktur data}"
        ],
        "description": "Komentar dokumentasi deklarasi ///"
    },
    "Buat Direktori": {
        "prefix": "buat_direktori",
        "body": [
            "buat_direktori(\"${1:jalur_folder}\") ? tangkap ${2:err} {",
            "\tcetak(\"Gagal membuat direktori: {${2:err}}\")",
            "\t$0",
            "}"
        ],
        "description": "Membuat direktori baru secara rekursif"
    },
    "Daftar Direktori": {
        "prefix": "daftar_direktori",
        "body": [
            "${1:daftar_entri} := daftar_direktori(\"${2:jalur_folder}\") ? tangkap ${3:err} {",
            "\tcetak(\"Gagal membaca direktori: {${3:err}}\")",
            "\t$0",
            "}"
        ],
        "description": "Membaca daftar entri berkas dan folder"
    },
    "Ambil Argumen CLI": {
        "prefix": "ambil_argumen_cli",
        "body": [
            "${1:argumen} := ambil_argumen_cli()"
        ],
        "description": "Mengambil daftar argumen baris perintah"
    },
    "Ambil Variabel Lingkungan": {
        "prefix": "ambil_lingkungan",
        "body": [
            "${1:nilai} := ambil_lingkungan(\"${2:NAMA_VARIABEL}\") ? tangkap ${3:err} {",
            "\t$0",
            "}"
        ],
        "description": "Membaca variabel lingkungan sistem operasi"
    },
    "Hitung SHA-256": {
        "prefix": "sha256",
        "body": [
            "${1:hash} := sha256(${2:teks_masukan})"
        ],
        "description": "Menghitung nilai hash SHA-256 (64 karakter heksadesimal)"
    },
    "Hitung MD5": {
        "prefix": "md5",
        "body": [
            "${1:hash} := md5(${2:teks_masukan})"
        ],
        "description": "Menghitung nilai hash MD5 (32 karakter heksadesimal)"
    },
    "Enkoding Base64": {
        "prefix": "ke_base64",
        "body": [
            "${1:b64} := ke_base64(${2:teks_masukan})"
        ],
        "description": "Mengenkode teks menjadi format Base64 RFC 4648"
    },
    "Dekoding Base64": {
        "prefix": "dari_base64",
        "body": [
            "${1:teks} := dari_base64(${2:teks_base64}) ? tangkap ${3:err} {",
            "\tcetak(\"Format Base64 tidak valid: {${3:err}}\")",
            "\t$0",
            "}"
        ],
        "description": "Mendekode teks berformat Base64 dengan penanganan galat"
    },
    "Buat Server Web HTTP": {
        "prefix": "server_http",
        "body": [
            "fungsi ${1:tangani_permintaan}(permintaan: PermintaanHttp) -> ResponsHttp {",
            "\tjika permintaan.jalur == \"${2:/api/halo}\" {",
            "\t\tkembali respons_json(\"{\\\"pesan\\\": \\\"Halo dari DapCode!\\\"}\")",
            "\t}",
            "\tkembali kirim_respons_http(404, \"text/plain\", \"Rute tidak ditemukan\")",
            "}",
            "",
            "buat_server_http(${3:8080}, \"${1:tangani_permintaan}\") ? tangkap err {",
            "\tcetak(\"Gagal menjalankan server: {err}\")",
            "}"
        ],
        "description": "Menjalankan HTTP Web Server REST API bawaan DapCode"
    },
    "Respons JSON HTTP": {
        "prefix": "respons_json",
        "body": [
            "respons_json(\"${1:{\\\"status\\\": \\\"sukses\\\"}}\")"
        ],
        "description": "Membuat ResponsHttp 200 OK dengan format JSON"
    },
    "Respons Teks HTTP": {
        "prefix": "respons_teks",
        "body": [
            "respons_teks(\"${1:Halo Dunia}\")"
        ],
        "description": "Membuat ResponsHttp 200 OK dengan format teks polos"
    },
    "Buka Basis Data": {
        "prefix": "buka_db",
        "body": [
            "db := buka_basis_data(\"${1:data.db}\") ? tangkap err {",
            "\tcetak(\"Gagal membuka database: {err}\")",
            "\tkembali",
            "}"
        ],
        "description": "Buka atau buat basis data mandiri DapCode"
    },
    "Simpan Basis Data": {
        "prefix": "db_simpan",
        "body": [
            "db.simpan(\"${1:kunci}\", ${2:nilai_teks}) ? tangkap err {",
            "\tcetak(\"Gagal menyimpan ke basis data: {err}\")",
            "}"
        ],
        "description": "Simpan nilai ke basis data berdasarkan kunci"
    },
    "Ambil Basis Data": {
        "prefix": "db_ambil",
        "body": [
            "${1:data} := db.ambil(\"${2:kunci}\") ? tangkap err {",
            "\tcetak(\"Data tidak ditemukan: {err}\")",
            "\t$0",
            "}"
        ],
        "description": "Ambil nilai dari basis data berdasarkan kunci"
    },
    "Pencocokan Rute Dinamis": {
        "prefix": "cocok_rute",
        "body": [
            "jika ${1:req}.cocok(\"${2:/api/item/:id}\") {",
            "\t${3:id} := ${1:req}.param(\"${2:/api/item/:id}\", \"${4:id}\") ? tangkap err {",
            "\t\tkembali respons_teks(err)",
            "\t}",
            "\t$0",
            "}"
        ],
        "description": "Pola pencocokan rute dinamis dengan parameter"
    },
    "Ambil Kueri Param": {
        "prefix": "ambil_kueri_param",
        "body": [
            "${1:nilai} := ${2:req}.kueri_param(\"${3:kunci}\") ? tangkap err {",
            "\t$0",
            "}"
        ],
        "description": "Ekstrak nilai parameter kueri dari permintaan HTTP"
    },
    "Respons CORS": {
        "prefix": "respons_cors",
        "body": [
            "respons_cors(${1:respons_json(\"${2:{\\\"status\\\": \\\"sukses\\\"}}\")})"
        ],
        "description": "Menambahkan header CORS ke respons HTTP"
    },
    "Respons Berkas": {
        "prefix": "respons_berkas",
        "body": [
            "respons_berkas(\"${1:jalur_berkas}\") ? tangkap err {",
            "\tkirim_respons_http(404, \"text/plain\", \"Berkas tidak ditemukan: {err}\")",
            "}"
        ],
        "description": "Membaca berkas dan menghasilkan respons HTTP dengan MIME otomatis"
    },
    "Sajikan Berkas Statis": {
        "prefix": "sajikan_berkas_statis",
        "body": [
            "sajikan_berkas_statis(\"${1:folder_publik}\", ${2:req}.jalur) ? tangkap err {",
            "\tkirim_respons_http(404, \"text/plain\", \"Aset statis tidak ditemukan\")",
            "}"
        ],
        "description": "Menyajikan aset statis dari direktori publik secara aman dengan MIME detection"
    },
    "Permintaan Sajikan Statis": {
        "prefix": "req.sajikan_statis",
        "body": [
            "${1:req}.sajikan_statis(\"${2:publik}\") ? tangkap err {",
            "\tkirim_respons_http(404, \"text/plain\", \"404 Tidak Ditemukan\")",
            "}"
        ],
        "description": "Metode permintaan HTTP untuk menyajikan berkas statis dari folder"
    },
    "WebSocket Server Dedicated": {
        "prefix": "buat_server_websocket",
        "body": [
            "fungsi tangani_pesan(pesan: Teks) -> Teks {",
            "\tcetak(\"Pesan diterima: {pesan}\")",
            "\tkembali \"Echo: {pesan}\"",
            "}",
            "",
            "fungsi utama() -> u64 {",
            "\thasil := buat_server_websocket(${1:8080}, \"tangani_pesan\") ? tangkap err {",
            "\t\tcetak(\"Gagal memulai WebSocket: {err}\")",
            "\t\tkembali 0",
            "\t}",
            "\tkembali hasil",
            "}"
        ],
        "description": "Server WebSocket mandiri (dedicated WebSocket server)"
    },
    "WebSocket Route Upgrade": {
        "prefix": "req.tingkatkan_websocket",
        "body": [
            "jika ${1:req}.adalah_websocket() {",
            "\tkembali ${1:req}.tingkatkan_websocket(\"${2:tangani_pesan}\") ? tangkap err {",
            "\t\tkirim_respons_http(400, \"text/plain\", \"Gagal upgrade ke WebSocket: {err}\")",
            "\t}",
            "}"
        ],
        "description": "Upgrade HTTP route ke WebSocket real-time frame connection"
    },
    "Cocokkan Regex": {
        "prefix": "cocok_regex",
        "body": [
            "cocok_regex(\"${1:\\\\d+}\", ${2:teks})"
        ],
        "description": "Periksa kecocokan pola regular expression pada teks"
    },
    "Cari Regex Semua": {
        "prefix": "cari_regex",
        "body": [
            "hasil := cari_regex(\"${1:\\\\d+}\", ${2:teks})"
        ],
        "description": "Cari seluruh substring yang cocok dengan pola regex sebagai Daftar<Teks>"
    },
    "Ganti Regex": {
        "prefix": "ganti_regex",
        "body": [
            "ganti_regex(\"${1:pola}\", ${2:teks}, \"${3:pengganti}\")"
        ],
        "description": "Ganti seluruh kecocokan regex dengan teks pengganti"
    },
    "Ekstrak Regex": {
        "prefix": "ekstrak_regex",
        "body": [
            "${1:hasil} := ekstrak_regex(\"${2:\\\\w+@\\\\w+\\\\.com}\", ${3:teks}) ? tangkap err {",
            "\t$0",
            "}"
        ],
        "description": "Ekstrak substring pertama yang cocok dengan regex (Error Union)"
    },
    "Kanvas Bersihkan": {
        "prefix": "kanvas_bersihkan",
        "body": [
            "kanvas_bersihkan(${1:0.05}, ${2:0.05}, ${3:0.08}, ${4:1.0})"
        ],
        "description": "Membersihkan kanvas dengan warna latar RGBA (0.0 - 1.0)"
    },
    "Kanvas Warna Isi": {
        "prefix": "kanvas_warna_isi",
        "body": [
            "kanvas_warna_isi(${1:0.2}, ${2:0.6}, ${3:1.0}, ${4:1.0})"
        ],
        "description": "Mengatur warna isi (fill color) untuk bentuk berikutnya pada Kanvas 2D"
    },
    "Kanvas Warna Garis": {
        "prefix": "kanvas_warna_garis",
        "body": [
            "kanvas_warna_garis(${1:1.0}, ${2:1.0}, ${3:1.0}, ${4:0.8})"
        ],
        "description": "Mengatur warna garis tepi (stroke color) pada Kanvas 2D"
    },
    "Kanvas Tebal Garis": {
        "prefix": "kanvas_tebal_garis",
        "body": [
            "kanvas_tebal_garis(${1:2.0})"
        ],
        "description": "Mengatur ketebalan garis (line width) pada Kanvas 2D"
    },
    "Kanvas Persegi Isi": {
        "prefix": "kanvas_persegi",
        "body": [
            "kanvas_persegi(${1:x}, ${2:y}, ${3:lebar}, ${4:tinggi})"
        ],
        "description": "Menggambar persegi terisi (fill rectangle) pada kanvas"
    },
    "Kanvas Bingkai Persegi": {
        "prefix": "kanvas_bingkai_persegi",
        "body": [
            "kanvas_bingkai_persegi(${1:x}, ${2:y}, ${3:lebar}, ${4:tinggi})"
        ],
        "description": "Menggambar bingkai persegi (stroke rectangle) pada kanvas"
    },
    "Kanvas Lingkaran Isi": {
        "prefix": "kanvas_lingkaran",
        "body": [
            "kanvas_lingkaran(${1:x}, ${2:y}, ${3:radius})"
        ],
        "description": "Menggambar lingkaran terisi (fill circle) pada kanvas"
    },
    "Kanvas Bingkai Lingkaran": {
        "prefix": "kanvas_bingkai_lingkaran",
        "body": [
            "kanvas_bingkai_lingkaran(${1:x}, ${2:y}, ${3:radius})"
        ],
        "description": "Menggambar bingkai lingkaran (stroke circle) pada kanvas"
    },
    "Kanvas Garis": {
        "prefix": "kanvas_garis",
        "body": [
            "kanvas_garis(${1:x1}, ${2:y1}, ${3:x2}, ${4:y2})"
        ],
        "description": "Menggambar garis lurus dari (x1, y1) ke (x2, y2)"
    },
    "Kanvas Titik": {
        "prefix": "kanvas_titik",
        "body": [
            "kanvas_titik(${1:x}, ${2:y}, ${3:3.0})"
        ],
        "description": "Menggambar titik / partikel pada posisi (x, y)"
    },
    "Kanvas Teks": {
        "prefix": "kanvas_teks",
        "body": [
            "kanvas_teks(\"${1:Teks}\", ${2:x}, ${3:y}, ${4:16.0})"
        ],
        "description": "Menggambar teks pada kanvas dengan ukuran font tertentu"
    },
    "Kanvas Dimensi": {
        "prefix": "kanvas_dimensi",
        "body": [
            "lebar := kanvas_lebar()",
            "tinggi := kanvas_tinggi()"
        ],
        "description": "Mendapatkan dimensi resolusi lebar dan tinggi Kanvas 2D"
    },
    "Kompilasi ke WebAssembly": {
        "prefix": "kompilasi_ke_wasm",
        "body": [
            "${1:wasm_base64} := kompilasi_ke_wasm(${2:kode_sumber}) ? tangkap err {",
            "\t$0",
            "}"
        ],
        "description": "Mengompilasi kode sumber DapCode ke WebAssembly (.wasm) Base64 secara in-memory"
    },
    "Template Kanvas 2D WebAssembly": {
        "prefix": "kanvas_template",
        "body": [
            "fungsi render() -> Unit {",
            "\tw := kanvas_lebar()",
            "\th := kanvas_tinggi()",
            "\tkanvas_bersihkan(0.05, 0.05, 0.08, 1.0)",
            "\t",
            "\tkanvas_warna_isi(0.2, 0.6, 1.0, 1.0)",
            "\tkanvas_lingkaran(w / 2.0, h / 2.0, 50.0)",
            "\t",
            "\tkanvas_warna_garis(1.0, 1.0, 1.0, 0.8)",
            "\tkanvas_tebal_garis(2.0)",
            "\tkanvas_bingkai_lingkaran(w / 2.0, h / 2.0, 55.0)",
            "\t",
            "\tkanvas_warna_isi(1.0, 1.0, 1.0, 0.9)",
            "\tkanvas_teks(\"DapCode WebAssembly Canvas 2D\", w / 2.0 - 120.0, h / 2.0 + 80.0, 14.0)",
            "}",
            "",
            "fungsi utama() -> u64 {",
            "\trender()",
            "\tkembali 1",
            "}"
        ],
        "description": "Kerangka fungsi render grafis Kanvas 2D interaktif untuk target WebAssembly"
    },
    "Kanvas Posisi Mouse X": {
        "prefix": "kanvas_mouse_x",
        "body": [
            "mx := kanvas_mouse_x()"
        ],
        "description": "Mendapatkan koordinat X kursor mouse pada Kanvas 2D"
    },
    "Kanvas Posisi Mouse Y": {
        "prefix": "kanvas_mouse_y",
        "body": [
            "my := kanvas_mouse_y()"
        ],
        "description": "Mendapatkan koordinat Y kursor mouse pada Kanvas 2D"
    },
    "Kanvas Klik Mouse": {
        "prefix": "kanvas_mouse_klik",
        "body": [
            "klik := kanvas_mouse_klik()"
        ],
        "description": "Memeriksa status klik tombol mouse pada kanvas (1=klik, 0=lepas)"
    },
    "Kanvas Tombol Keyboard Ditekan": {
        "prefix": "kanvas_tombol_ditekan",
        "body": [
            "ditekan := kanvas_tombol_ditekan(${1:32})"
        ],
        "description": "Memeriksa apakah tombol keyboard tertentu sedang ditekan (32=Spasi, 37=Kiri, 38=Atas, 39=Kanan, 40=Bawah)"
    },
    "Template Game 2D Interaktif": {
        "prefix": "game_2d_template",
        "body": [
            "fungsi render_game() -> Unit {",
            "\tw := kanvas_lebar()",
            "\th := kanvas_tinggi()",
            "\tmx := kanvas_mouse_x()",
            "\tmy := kanvas_mouse_y()",
            "\tklik := kanvas_mouse_klik()",
            "\t",
            "\tkanvas_bersihkan(0.04, 0.05, 0.08, 1.0)",
            "\t",
            "\t// Objek pemain mengikuti kursor mouse",
            "\tkanvas_warna_isi(0.2, 0.6, 1.0, 1.0)",
            "\tkanvas_lingkaran(mx, my, 18.0)",
            "\t",
            "\tjika klik == 1 {",
            "\t\tkanvas_warna_garis(1.0, 0.4, 0.2, 1.0)",
            "\t\tkanvas_tebal_garis(3.0)",
            "\t\tkanvas_garis(mx, my, w, my)",
            "\t}",
            "}",
            "",
            "fungsi utama() -> u64 {",
            "\trender_game()",
            "\tkembali 1",
            "}"
        ],
        "description": "Kerangka game 2D interaktif berbasis pergerakan mouse dan klik di Kanvas DapCode"
    },
    "Kanvas Delta Waktu": {
        "prefix": "kanvas_delta_waktu",
        "body": [
            "dt := kanvas_delta_waktu()"
        ],
        "description": "Mendapatkan selang waktu (delta time) antar-frame dalam detik (f64, misal: 0.0166 untuk 60 FPS)"
    },
    "Template Animasi Fisika & Delta Time": {
        "prefix": "kanvas_animasi_loop",
        "body": [
            "fungsi render_animasi() -> Unit {",
            "\tw := kanvas_lebar()",
            "\th := kanvas_tinggi()",
            "\tdt := kanvas_delta_waktu()",
            "\tmx := kanvas_mouse_x()",
            "\tmy := kanvas_mouse_y()",
            "\t",
            "\tkanvas_bersihkan(0.04, 0.05, 0.08, 1.0)",
            "\t",
            "\t// Hitung kecepatan & posisi pergerakan dengan delta waktu (kecepatan * dt)",
            "\tkanvas_warna_isi(0.2, 0.7, 1.0, 0.9)",
            "\tkanvas_lingkaran(mx, my, 20.0)",
            "\tkanvas_warna_isi(1.0, 1.0, 1.0, 1.0)",
            "\tkanvas_teks(\"Animasi Loop 60 FPS\", 20.0, 30.0, 12.0)",
            "}",
            "",
            "fungsi utama() -> u64 {",
            "\trender_animasi()",
            "\tkembali 1",
            "}"
        ],
        "description": "Kerangka animasi loop grafis Kanvas 2D berbasis selang waktu delta frame (kanvas_delta_waktu)"
    },
