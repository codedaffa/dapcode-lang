{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DapCode",
    "scopeName": "source.dap",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#builtins" },
        { "include": "#function-declarations" },
        { "include": "#function-calls" },
        { "include": "#numbers" },
        { "include": "#operators" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.documentation.module.dap",
                    "match": "//[!].*$"
                },
                {
                    "name": "comment.line.documentation.dap",
                    "match": "///.*$"
                },
                {
                    "name": "comment.line.double-slash.dap",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.dap",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.dap",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dap",
                            "match": "\\\\([nrt\\\\\"{}])"
                        },
                        {
                            "name": "meta.interpolation.dap",
                            "begin": "(?<!\\\\)\\{",
                            "end": "\\}",
                            "beginCaptures": {
                                "0": { "name": "punctuation.section.interpolation.begin.dap" }
                            },
                            "endCaptures": {
                                "0": { "name": "punctuation.section.interpolation.end.dap" }
                            },
                            "patterns": [
                                { "include": "$self" }
                            ]
                        }
                    ]
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.declaration.dap",
                    "match": "\\b(struktur|sifat|terapkan|untuk|fungsi|comptime|impor|uji)\\b"
                },
                {
                    "name": "keyword.control.dap",
                    "match": "\\b(jika|selain_itu|selama|untuk|di|dalam|kembali)\\b"
                },
                {
                    "name": "keyword.control.exception.dap",
                    "match": "\\b(gagal|tangkap)\\b"
                },
                {
                    "name": "keyword.control.concurrency.dap",
                    "match": "\\b(jalan_paralel|tunggu)\\b"
                },
                {
                    "name": "variable.language.this.dap",
                    "match": "\\b(ini)\\b"
                }
            ]
        },
        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.dap",
                    "match": "\\b(cetak|ke_json|uraikan_json|urai_json|ambil_kunci_json|ambil_angka_json|ambil_bool_json|ada_kunci_json|valid_json|baca_berkas|tulis_berkas|tambah_berkas|berkas_ada|ada_berkas|buat_direktori|daftar_direktori|hapus_berkas|hapus_direktori|gabung_jalur|tidur|ambil_argumen_cli|ambil_lingkungan|atur_lingkungan|pastikan|pastikan_sama|pastikan_tidak_sama|panjang_teks|ke_huruf_besar|ke_huruf_kecil|akar_kuadrat|pangkat|nilai_mutlak|waktu_sekarang_ms|ambil_http|kirim_http_post|ambil_status_http|dorong|tarik|panjang|ambil|sha256|md5|ke_base64|dari_base64)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.dap",
                    "match": "\\b(benar|salah)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.dap",
                    "match": "\\b(u64|i64|f64|Teks|Bool|Unit|Tugas|Daftar|bulat|desimal|teks|bool|unit)\\b"
                },
                {
                    "name": "entity.name.type.struct.dap",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "function-declarations": {
            "match": "\\b(fungsi)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": { "name": "keyword.declaration.dap" },
                "2": { "name": "entity.name.function.dap" }
            }
        },
        "function-calls": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": { "name": "entity.name.function.call.dap" }
            }
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.dap",
                    "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*\\b"
                },
                {
                    "name": "constant.numeric.integer.dap",
                    "match": "\\b\\d[\\d_]*\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.walrus.dap",
                    "match": ":="
                },
                {
                    "name": "keyword.operator.arrow.dap",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.comparison.dap",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.logical.dap",
                    "match": "(&&|\\|\\|)"
                },
                {
                    "name": "keyword.operator.arithmetic.dap",
                    "match": "(\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.error.dap",
                    "match": "(\\?|!)"
                },
                {
                    "name": "keyword.operator.assignment.dap",
                    "match": "="
                }
            ]
        }
    }
}
