{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "DQL (DapCode Query Language)",
    "scopeName": "source.dql",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#constants" },
        { "include": "#aggregates" },
        { "include": "#keywords" },
        { "include": "#predicates" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#qualified-columns" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.dql",
                    "match": "#.*$"
                },
                {
                    "name": "comment.line.double-slash.dql",
                    "match": "//.*$"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.dql",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dql",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.dql",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dql",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.dql",
                    "match": "\\b(benar|salah|true|false)\\b"
                },
                {
                    "name": "constant.language.null.dql",
                    "match": "\\b(nihil|kosong|null)\\b"
                }
            ]
        },
        "aggregates": {
            "patterns": [
                {
                    "name": "support.function.aggregate.dql",
                    "match": "\\b(hitung|jumlah|rata_rata|maks|min|count|sum|avg|max)\\b(?=\\s*\\()"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.query.dql",
                    "match": "\\b(ambil|dari|pilih|sebagai|as)\\b"
                },
                {
                    "name": "keyword.control.conditional.dql",
                    "match": "\\b(di_mana|dimana|filter|where|memiliki|having)\\b"
                },
                {
                    "name": "keyword.control.join.dql",
                    "match": "\\b(gabung_kiri|gabung_kanan|gabung_dalam|gabung|left_join|right_join|inner_join|join|pada|on)\\b"
                },
                {
                    "name": "keyword.control.group-order.dql",
                    "match": "\\b(kelompokkan|group_by|urutkan|order_by|naik|turun|asc|desc)\\b"
                },
                {
                    "name": "keyword.control.paging.dql",
                    "match": "\\b(batasi|limit|lewati|offset)\\b"
                },
                {
                    "name": "keyword.control.mutation.dql",
                    "match": "\\b(tambah_ke|sisip|insert_into|perbarui|update|atur|set|hapus_dari|delete_from)\\b"
                },
                {
                    "name": "keyword.control.ddl.dql",
                    "match": "\\b(buat|hapus|tabel|basis_data|database|jika_ada|jika_belum_ada|tampilkan|lihat|show|struktur|deskripsi|describe)\\b"
                },
                {
                    "name": "storage.modifier.constraint.dql",
                    "match": "\\b(kunci_utama|primary_key|tidak_kosong|not_null|unik|unique|bawaan|default|otomatis|auto_increment|sekarang|now)\\b"
                },
                {
                    "name": "storage.type.dql",
                    "match": "\\b(seri|serial|id_otomatis|teks|text|string|bulat|integer|int|desimal|pecahan|float|double|boolean|bool|waktu|tanggal|timestamp|datetime|json|blob|biner)\\b"
                }
            ]
        },
        "predicates": {
            "patterns": [
                {
                    "name": "keyword.operator.logical.dql",
                    "match": "\\b(dan|and|atau|or|tidak|bukan|not)\\b"
                },
                {
                    "name": "keyword.operator.comparison.dql",
                    "match": "\\b(seperti|like|berisi|diawali|diakhiri|di_dalam|dalam|in|antara|between)\\b"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.dql",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.dql",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.dql",
                    "match": "(==|!=|<>|<=|>=|<|>|=)"
                },
                {
                    "name": "keyword.operator.arithmetic.dql",
                    "match": "(\\+|-|\\*|/)"
                },
                {
                    "name": "keyword.operator.pipeline.dql",
                    "match": "(\\|)"
                }
            ]
        },
        "qualified-columns": {
            "patterns": [
                {
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*|\\*)",
                    "captures": {
                        "1": { "name": "entity.name.type.table.dql" },
                        "2": { "name": "variable.other.property.column.dql" }
                    }
                }
            ]
        }
    }
}
