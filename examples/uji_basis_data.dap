/// Contoh Basis Data Mandiri & Persistensi Data REST API Bawaan DapCode
/// Menunjukkan penggunaan BasisData terstruktur lokal dengan Transaksi Atomik (ACID),
/// Pencarian Awalan (Prefix Query), serta Ekspor & Impor JSON tanpa dependensi eksternal.

fungsi demo_database_dasar() {
    cetak("--- 1. Operasi Basis Data Langsung (CRUD) ---")
    db_file := "contoh_toko.db"

    db := buka_basis_data(db_file) ? tangkap err {
        cetak("Gagal membuka database: {err}")
        kembali
    }

    // 1. Simpan data produk
    db.simpan("produk:101", "\{\"nama\":\"Kopi Arabika Gayo\",\"harga\":35000,\"stok\":20\}") ? tangkap err {
        cetak("Gagal menyimpan: {err}")
    }
    db.simpan("produk:102", "\{\"nama\":\"Teh Hitam Organik\",\"harga\":18000,\"stok\":45\}") ? tangkap err {
        cetak("Gagal menyimpan: {err}")
    }

    // 2. Periksa keberadaan
    ada_101 := db.ada("produk:101")
    cetak("Produk 101 terdaftar: {ada_101}")

    // 3. Ambil data
    data_101 := db.ambil("produk:101") ? tangkap err {
        cetak("Gagal mengambil data: {err}")
        kembali
    }
    cetak("Data produk 101: {data_101}")

    // 4. Daftar semua kunci aktif
    kunci_list := db.daftar_kunci() ? tangkap err {
        Daftar()
    }
    cetak("Jumlah total entri di database: {kunci_list.panjang()}")
}

fungsi demo_transaksi_acid() {
    cetak("")
    cetak("--- 2. Transaksi Atomik (ACID Commit & Rollback) ---")
    db := buka_basis_data("contoh_toko.db") ? tangkap err {
        kembali
    }

    // A. Uji Coba Rollback (Batal)
    db.mulai_transaksi() ? tangkap err {
        cetak("Gagal mulai transaksi: {err}")
    }
    cetak("Status transaksi aktif: {db.sedang_transaksi()}")

    db.simpan("produk:999", "\{\"nama\":\"Produk Batal\",\"harga\":99999\}") ? tangkap err {}
    cetak("Data 999 dalam transaksi: {db.ambil(\"produk:999\")}")

    db.batal() ? tangkap err {
        cetak("Gagal membatalkan transaksi: {err}")
    }
    cetak("Setelah dibatalkan, produk 999 ada: {db.ada(\"produk:999\")}")

    // B. Uji Coba Commit (Komit Atomik)
    db.mulai_transaksi() ? tangkap err {}
    db.simpan("produk:103", "\{\"nama\":\"Cokelat Luwu\",\"harga\":25000,\"stok\":30\}") ? tangkap err {}
    db.simpan("produk:104", "\{\"nama\":\"Madu Hutan Sumbawa\",\"harga\":75000,\"stok\":15\}") ? tangkap err {}
    db.komit() ? tangkap err {
        cetak("Gagal komit transaksi: {err}")
    }
    cetak("Batch komit berhasil! Produk 103 terdaftar: {db.ada(\"produk:103\")}")
}

fungsi demo_prefix_dan_json() {
    cetak("")
    cetak("--- 3. Pencarian Awalan (Prefix) & Ekspor/Impor JSON ---")
    db := buka_basis_data("contoh_toko.db") ? tangkap err {
        kembali
    }

    // 1. Pencarian dengan awalan "produk:"
    kunci_produk := db.ambil_awalan("produk:") ? tangkap err {
        Daftar()
    }
    cetak("Daftar kunci produk (prefix 'produk:'): {kunci_produk.panjang()} item ditemukan")

    // 2. Ekspor ke teks JSON
    json_produk := db.ekspor_json_awalan("produk:") ? tangkap err {
        "{}"
    }
    cetak("Hasil Ekspor JSON Produk:")
    cetak(json_produk)

    // 3. Impor pasangan data JSON baru
    data_baru := "\{\"kategori:kopi\":\"Minuman Seduh\",\"kategori:snack\":\"Makanan Ringan\"\}"
    jumlah := db.impor_json(data_baru) ? tangkap err {
        0
    }
    cetak("Berhasil mengimpor {jumlah} kategori ke basis data!")

    // 4. Padatkan basis data
    db.padatkan() ? tangkap err {
        cetak("Gagal memadatkan: {err}")
    }
    cetak("Basis data berhasil dipadatkan!")
}

// Fungsi penangan HTTP Web Server yang terhubung langsung ke BasisData
fungsi tangani_api_db(req: PermintaanHttp) -> ResponsHttp {
    db := buka_basis_data("contoh_toko.db") ? tangkap err {
        kembali kirim_respons_http(500, "text/plain", "Database error: " + err)
    }

    // Endpoint GET /api/produk/101
    jika req.jalur == "/api/produk/101" {
        json_data := db.ambil("produk:101") ? tangkap err {
            kembali kirim_respons_http(404, "text/plain", "Produk tidak ditemukan")
        }
        kembali respons_json(json_data)
    }

    // Endpoint GET /api/ekspor/produk
    jika req.jalur == "/api/ekspor/produk" {
        ekspor := db.ekspor_json_awalan("produk:") ? tangkap err {
            "{}"
        }
        kembali respons_json(ekspor)
    }

    // Endpoint GET /api/daftar
    jika req.jalur == "/api/daftar" {
        kunci_list := db.daftar_kunci() ? tangkap err {
            Daftar()
        }
        kembali respons_json(ke_json(kunci_list))
    }

    kembali kirim_respons_http(404, "text/plain", "Endpoint tidak ditemukan")
}

fungsi utama() {
    demo_database_dasar()
    demo_transaksi_acid()
    demo_prefix_dan_json()

    cetak("")
    cetak("--- 4. REST API Persisten Berbasis BasisData ---")
    cetak("Menjalankan server selama 1 permintaan uji...")

    // Jalankan server HTTP yang terintegrasi dengan database
    _hasil := buat_server_http(8081, "tangani_api_db", 1) ? tangkap err {
        cetak("Server error: {err}")
        kembali
    }
}
