// ============================================================================
// 📱 Komponen Antarmuka Layar Sentuh & GPU
// ============================================================================

fungsi gambar_status_bar(w: f64) -> Unit {
    kanvas_warna_isi(0.04, 0.06, 0.12, 0.95)
    kanvas_persegi(0.0, 0.0, w, 24.0)
    
    // Jam
    kanvas_warna_isi(0.9, 0.95, 1.0, 0.9)
    kanvas_teks("09:41", 14.0, 16.0, 10.5)
    
    // Ikon Sinyal
    kanvas_warna_isi(0.2, 0.85, 0.5, 0.9)
    kanvas_persegi(w - 56.0, 8.0, 3.0, 8.0)
    kanvas_persegi(w - 50.0, 6.0, 3.0, 10.0)
    kanvas_persegi(w - 44.0, 4.0, 3.0, 12.0)
    
    // Ikon Baterai
    kanvas_warna_garis(0.9, 0.95, 1.0, 0.7)
    kanvas_tebal_garis(1.0)
    kanvas_bingkai_persegi(w - 30.0, 5.0, 18.0, 10.0)
    kanvas_warna_isi(0.2, 0.9, 0.5, 0.9)
    kanvas_persegi(w - 28.0, 7.0, 12.0, 6.0)
}

fungsi gambar_app_bar(w: f64, judul: Teks) -> Unit {
    kanvas_warna_isi(0.06, 0.10, 0.20, 0.98)
    kanvas_persegi(0.0, 24.0, w, 54.0)
    
    kanvas_warna_isi(0.12, 0.55, 0.95, 0.9)
    kanvas_persegi(0.0, 77.0, w, 1.5)
    
    kanvas_warna_isi(1.0, 1.0, 1.0, 1.0)
    kanvas_teks(judul, 14.0, 48.0, 15.0)
    
    kanvas_warna_isi(0.02, 0.45, 0.85, 0.4)
    kanvas_persegi(14.0, 56.0, 150.0, 14.0)
    kanvas_warna_garis(0.25, 0.75, 1.0, 0.8)
    kanvas_tebal_garis(1.0)
    kanvas_bingkai_persegi(14.0, 56.0, 150.0, 14.0)
    
    kanvas_warna_isi(0.4, 0.9, 1.0, 1.0)
    kanvas_teks("DIRECT GPU 60 FPS • FLUTTER STYLE", 18.0, 67.0, 8.5)
}

fungsi gambar_layar_tampilan(w: f64, sy: f64, sh: f64, riwayat: Teks, tampilan: Teks) -> Unit {
    sx := 14.0
    sw := w - 28.0

    // Kotak Display Glassmorphic
    kanvas_warna_isi(0.07, 0.11, 0.22, 0.95)
    kanvas_persegi(sx, sy, sw, sh)

    kanvas_warna_garis(0.22, 0.48, 0.85, 0.6)
    kanvas_tebal_garis(1.5)
    kanvas_bingkai_persegi(sx, sy, sw, sh)

    kanvas_warna_isi(0.2, 0.9, 0.4, 0.8)
    kanvas_lingkaran(sx + 14.0, sy + 18.0, 3.5)
    kanvas_warna_isi(0.5, 0.75, 0.95, 0.8)
    kanvas_teks("Display Aktif", sx + 24.0, sy + 21.0, 9.0)

    // Riwayat
    kanvas_warna_isi(0.55, 0.72, 0.95, 0.85)
    kanvas_teks(riwayat, sx + 14.0, sy + sh * 0.45, 12.0)

    // Angka Utama
    kanvas_warna_isi(1.0, 1.0, 1.0, 1.0)
    kanvas_teks(tampilan, sx + 14.0, sy + sh * 0.85, 20.0)
}

fungsi gambar_tombol(label: Teks, bx: f64, by: f64, bw: f64, bh: f64, jenis: u64, mx: f64, my: f64, klik: u64) -> Unit {
    hover := (mx >= bx && mx <= bx + bw && my >= by && my <= by + bh)
    ditekan := hover && (klik == 1)

    jika jenis == 3 {
        // Tombol Sama Dengan (=)
        jika ditekan {
            kanvas_warna_isi(0.20, 0.90, 0.60, 1.0)
        } selain_itu jika hover {
            kanvas_warna_isi(0.16, 0.78, 0.50, 1.0)
        } selain_itu {
            kanvas_warna_isi(0.12, 0.68, 0.42, 0.95)
        }
    } selain_itu jika jenis == 2 {
        // Tombol Operator (+, -, *, /)
        jika ditekan {
            kanvas_warna_isi(0.35, 0.78, 1.0, 1.0)
        } selain_itu jika hover {
            kanvas_warna_isi(0.20, 0.65, 0.95, 1.0)
        } selain_itu {
            kanvas_warna_isi(0.08, 0.50, 0.88, 0.95)
        }
    } selain_itu jika jenis == 1 {
        // Tombol Fungsi (C, +/-, %, <)
        jika ditekan {
            kanvas_warna_isi(0.35, 0.40, 0.55, 1.0)
        } selain_itu jika hover {
            kanvas_warna_isi(0.28, 0.32, 0.44, 1.0)
        } selain_itu {
            kanvas_warna_isi(0.18, 0.22, 0.32, 0.95)
        }
    } selain_itu {
        // Tombol Angka (0-9, .)
        jika ditekan {
            kanvas_warna_isi(0.25, 0.30, 0.42, 1.0)
        } selain_itu jika hover {
            kanvas_warna_isi(0.18, 0.23, 0.35, 1.0)
        } selain_itu {
            kanvas_warna_isi(0.10, 0.14, 0.24, 0.95)
        }
    }

    kanvas_persegi(bx, by, bw, bh)

    kanvas_warna_garis(0.25, 0.45, 0.75, 0.45)
    kanvas_tebal_garis(1.0)
    kanvas_bingkai_persegi(bx, by, bw, bh)

    kanvas_warna_isi(1.0, 1.0, 1.0, 1.0)
    tx := bx + bw / 2.0 - 5.0
    ty := by + bh / 2.0 + 5.0
    kanvas_teks(label, tx, ty, 13.0)
}

fungsi tombol_ditekan(bx: f64, by: f64, bw: f64, bh: f64, mx: f64, my: f64, baru_klik: Bool) -> Bool {
    jika baru_klik {
        jika mx >= bx && mx <= bx + bw && my >= by && my <= by + bh {
            kembali benar
        }
    }
    kembali salah
}
