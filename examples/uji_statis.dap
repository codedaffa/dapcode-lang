// ===================================================================
// Contoh Penggunaan: Server Web Aset Statis, REST API & WebSocket Real-Time DapCode
// ===================================================================

fungsi tangani_pesan_ws(pesan: Teks) -> Teks {
    cetak("💬 WebSocket menerima pesan: {pesan}")
    kembali "DapCode Real-Time Echo: {pesan}"
}

fungsi tangani_permintaan(req: PermintaanHttp) -> ResponsHttp {
    // 1. Endpoint Real-Time WebSocket (/ws)
    jika req.jalur == "/ws" && req.adalah_websocket() {
        kembali req.tingkatkan_websocket("tangani_pesan_ws") ? tangkap err {
            kirim_respons_http(400, "text/plain", "Gagal upgrade ke WebSocket: {err}")
        }
    }

    // 2. Endpoint REST API Dinamis
    jika req.jalur == "/api/status" {
        respons := respons_json("\{\"status\": \"online\", \"versi\": \"0.5.0\", \"engine\": \"DapCode\", \"websocket\": \"aktif\"\}")
        kembali respons.cors()
    }

    // 2b. Endpoint Live Compiler WebAssembly (/api/kompilasi)
    jika req.jalur == "/api/kompilasi" && req.metode == "POST" {
        kode := ambil_kunci_json(req.isi, "kode") ? tangkap _ {
            kembali respons_json("\{\"sukses\": false, \"galat\": \"Format JSON tidak valid atau bidang 'kode' hilang\"\}").cors()
        }
        wasm_b64 := kompilasi_ke_wasm(kode) ? tangkap err {
            kembali respons_json("\{\"sukses\": false, \"galat\": \"{err}\"\}").cors()
        }
        panjang := panjang_teks(wasm_b64)
        respons := respons_json("\{\"sukses\": true, \"wasm_base64\": \"{wasm_b64}\", \"panjang_base64\": {panjang}\}")
        kembali respons.cors()
    }

    jika cocok_rute("/api/pengguna/:id", req.jalur) {
        id := req.param("/api/pengguna/:id", "id") ? tangkap err {
            kembali respons_teks("Parameter tidak valid").cors()
        }
        respons := respons_json("\{\"pengguna_id\": \"{id}\", \"peran\": \"pengembang\"\}")
        kembali respons.cors()
    }

    // 3. Sajikan Aset Statis (HTML, CSS, JS, Gambar) dari folder 'examples/publik'
    // Otomatis mendeteksi tipe MIME dan mengarahkan '/' ke 'index.html'
    aset := req.sajikan_statis("examples/publik") ? tangkap err {
        // Fallback jika berkas statis atau rute tidak ditemukan
        kirim_respons_http(404, "text/html; charset=utf-8", "<h1>404 Halaman Tidak Ditemukan</h1><p>DapCode Web Server</p>")
    }

    kembali aset
}

fungsi utama() {
    port := 8080
    cetak("🚀 Menjalankan Server Web DapCode...")
    cetak("📂 Folder Statis: examples/publik/")
    cetak("🌐 Akses di browser: http://localhost:{port}/")
    cetak("⚡ API Status: http://localhost:{port}/api/status")
    cetak("🔌 WebSocket Endpoint: ws://localhost:{port}/ws")

    // Jalankan server HTTP bawaan (dapat dihentikan dengan Ctrl+C)
    hasil := buat_server_http(port, "tangani_permintaan") ? tangkap err {
        cetak("❌ Gagal menjalankan server: {err}")
        kembali
    }

    cetak("Server selesai melayani {hasil} permintaan.")
}
