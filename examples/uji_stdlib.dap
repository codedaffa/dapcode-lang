fungsi demonstrasi_koleksi() {
    cetak("=== 1. Uji Koleksi Dinamis (Daftar<T>) ===")
    daftar_nilai := Daftar(85, 90, 78)
    daftar_nilai.tambah(95)
    total_data := daftar_nilai.panjang()
    cetak("Total nilai tersimpan: {total_data}")
    nilai_pertama := daftar_nilai.ambil(0) ? tangkap err {
        cetak("Gagal mengambil data: {err}")
        kembali
    }
    cetak("Nilai pertama: {nilai_pertama}")
    nilai_luar := daftar_nilai.ambil(99) ? tangkap err {
        cetak("Aman! Error tertangkap saat indeks di luar batas: {err}")
    }
    cetak("Iterasi semua nilai dengan 'untuk ... di ...':")
    untuk nilai di daftar_nilai {
        cetak("- Nilai siswa: {nilai}")
    }
}

fungsi demonstrasi_string_dan_matematika() {
    cetak("
=== 2. Uji Utilitas String & Matematika ===")
    judul := "bahasa pemrograman dapcode"
    cetak("Asli: {judul}")
    huruf_besar := ke_huruf_besar(judul)
    cetak("Huruf Besar: {huruf_besar}")
    pjg := panjang_teks(judul)
    cetak("Panjang karakter: {pjg}")
    akar := akar_kuadrat(144.0)
    cetak("Akar kuadrat dari 144: {akar}")
    dua_pangkat_delapan := pangkat(2.0, 8.0)
    cetak("2 pangkat 8: {dua_pangkat_delapan}")
    abs_val := nilai_mutlak(-99.75)
    cetak("Nilai mutlak -99.75: {abs_val}")
}

fungsi demonstrasi_berkas_dan_waktu() {
    cetak("
=== 3. Uji I/O Berkas, Direktori & Waktu ===")
    waktu_awal := waktu_sekarang_ms()

    // 1. Buat direktori sementara & gabung jalur
    folder_target := "folder_uji_dapcode"
    buat_direktori(folder_target) ? tangkap err {
        cetak("Gagal membuat direktori: {err}")
    }
    cetak("Sukses membuat direktori: {folder_target}")

    nama_berkas := gabung_jalur(folder_target, "catatan_dapcode.txt")
    pesan := "DapCode adalah bahasa modern dengan sintaks bersih berbahasa Indonesia."
    tulis_berkas(nama_berkas, pesan) ? tangkap err {
        cetak("Gagal menulis berkas: {err}")
        kembali
    }
    cetak("Sukses menulis ke berkas: {nama_berkas}")

    ada := ada_berkas(nama_berkas)
    jika ada {
        cetak("Status berkas: ditemukan di disk.")
    }

    isi := baca_berkas(nama_berkas) ? tangkap err {
        cetak("Gagal membaca berkas: {err}")
        kembali
    }
    cetak("Isi berkas yang dibaca: {isi}")

    // 2. Baca isi direktori
    daftar_file := daftar_direktori(folder_target) ? tangkap err {
        cetak("Gagal baca direktori: {err}")
        Daftar()
    }
    cetak("Jumlah entri di direktori {folder_target}: {daftar_file.panjang()}")

    // 3. Bersihkan berkas uji
    hapus_berkas(nama_berkas) ? tangkap err {
        cetak("Gagal menghapus berkas: {err}")
    }
    cetak("Berkas uji berhasil dibersihkan dengan hapus_berkas().")

    hapus_direktori(folder_target) ? tangkap err {
        cetak("Direktori dibersihkan.")
    }

    // 4. Uji jeda tidur (timer)
    cetak("Menjalankan jeda timer tidur(10 ms)...")
    tidur(10)

    waktu_akhir := waktu_sekarang_ms()
    selisih := waktu_akhir - waktu_awal
    cetak("Waktu eksekusi operasi: {selisih} ms")
}

struktur AkunPengguna {
    id: u64
    nama: Teks
    saldo: f64
    aktif: Bool
}

fungsi demonstrasi_json() {
    cetak("
=== 4. Uji Serialisasi & Penguraian JSON ===")
    user := AkunPengguna(id: 1001, nama: "Ahmad Dahlan", saldo: 2500000.75, aktif: benar)
    json_teks := ke_json(user)
    cetak("Hasil ke_json struktur: {json_teks}")

    nama_user := ambil_kunci_json(json_teks, "nama") ? tangkap err {
        cetak("Gagal ambil nama: {err}")
        kembali
    }
    cetak("Nama dari JSON: {nama_user}")

    saldo_user := ambil_angka_json(json_teks, "saldo") ? tangkap err {
        cetak("Gagal ambil saldo: {err}")
        kembali
    }
    cetak("Saldo dari JSON: Rp{saldo_user}")

    status_aktif := ambil_bool_json(json_teks, "aktif") ? tangkap err {
        cetak("Gagal ambil aktif: {err}")
        kembali
    }
    cetak("Status aktif: {status_aktif}")

    apakah_valid := valid_json(json_teks)
    cetak("Validitas JSON: {apakah_valid}")
}

fungsi demonstrasi_jaringan() {
    cetak("\n=== 5. Uji Jaringan & HTTP Client ===")
    status := ambil_status_http("https://httpbin.org/get") ? tangkap err {
        cetak("Status koneksi: offline atau fallback ({err})")
        kembali
    }
    cetak("Status HTTP GET httpbin.org: {status}")

    respons := ambil_http("https://httpbin.org/get") ? tangkap err {
        cetak("Gagal ambil HTTP: {err}")
        kembali
    }
    ada_header := ada_kunci_json(respons, "headers")
    cetak("Respons HTTP berhasil diterima! Ada kunci 'headers': {ada_header}")
}

fungsi demonstrasi_lingkungan_dan_cli() {
    cetak("\n=== 6. Uji Argumen CLI & Variabel Lingkungan ===")
    
    // 1. Baca argumen baris perintah
    argumen := ambil_argumen_cli()
    total_arg := argumen.panjang()
    cetak("Total argumen CLI yang diterima: {total_arg}")
    
    // 2. Setel & baca variabel lingkungan
    atur_lingkungan("DAPCODE_MODE", "PRODUKSI")
    mode := ambil_lingkungan("DAPCODE_MODE") ? tangkap err {
        "tidak_disetel"
    }
    cetak("Nilai variabel lingkungan DAPCODE_MODE: {mode}")

    // 3. Tangani variabel lingkungan yang tidak ada secara aman
    rahasia := ambil_lingkungan("VARIABEL_RAHASIA_XYZ") ? tangkap err {
        "Aman: tertangkap saat variabel lingkungan tidak ada"
    }
    cetak("Pengecekan variabel tidak terdaftar: {rahasia}")
}

fungsi utama() {
    cetak("===========================================")
    cetak("      DEMONSTRASI PUSTAKA STANDAR DAPCODE   ")
    cetak("===========================================")
    demonstrasi_koleksi()
    demonstrasi_string_dan_matematika()
    demonstrasi_berkas_dan_waktu()
    demonstrasi_json()
    demonstrasi_jaringan()
    demonstrasi_lingkungan_dan_cli()
    cetak("
Semua demonstrasi Pustaka Standar selesai dengan sukses!")
}
