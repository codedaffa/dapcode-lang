{
    "files.associations": {
        "*.dap": "dapcode",
        "*.dql": "dql"
    },
    "material-icon-theme.files.associations": {
        "*.dap": "rust"
    },
    "vsicons.associations.files": [
        {
            "icon": "code",
            "extensions": ["dap"],
            "format": "svg"
        }
    ],
    "[dapcode]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.wordWrap": "on"
    }
}
